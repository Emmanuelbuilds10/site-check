# ---------------------------------------------------------------------------
# Site Check - environment variables
#
# Copy this file to ".env.local" and fill in your own keys.
# Never commit the real .env.local file and never hardcode keys in the code.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Google PageSpeed Insights API key (Google Cloud Console).
PAGESPEED_API_KEY=

# Google Safe Browsing API key (Google Cloud Console).
SAFE_BROWSING_API_KEY=

# Google Gemini API key (Google AI Studio).
GEMINI_API_KEY=

# Which Gemini model to use. Must be a Flash model for speed and cost.
# Current stable Flash model name. Google renames these often - check
# https://ai.google.dev/gemini-api/docs/models if requests start failing.
GEMINI_MODEL=gemini-3.8-flash

# Optional. If the model above is busy (Google's newest Flash models
# occasionally answer "experiencing high demand") or has been renamed, the app
# retries once and then tries this model instead, so you still get a real
# report. Set it to "none" to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
